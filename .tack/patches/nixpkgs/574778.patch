From 823693bf8f5c9e17fe617a9e2ad3c7dda412ad84 Mon Sep 17 00:00:00 2001
From: Connor Alecks <git@econnah.uk>
Date: Fri, 16 Oct 2026 08:47:58 +0200
Subject: [PATCH 2/2] lazyspotify: add custom keyring support

---
 pkgs/by-name/la/lazyspotify/package.nix | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/pkgs/by-name/la/lazyspotify/package.nix b/pkgs/by-name/la/lazyspotify/package.nix
index f3d3c0ae8f1ce..3ef806af08c26 100644
--- a/pkgs/by-name/la/lazyspotify/package.nix
+++ b/pkgs/by-name/la/lazyspotify/package.nix
@@ -4,6 +4,7 @@
   fetchFromGitHub,
   lib,
   versionCheckHook,
+  customKeyring ? null,
 }:
 buildGoModule (finalAttrs: {
   pname = "lazyspotify";
@@ -22,6 +23,14 @@ buildGoModule (finalAttrs: {
 
   subPackages = [ "cmd/lazyspotify" ];
 
+  # lets me use oo7 with /org/freedesktop/secrets/collection/Login
+  # unsure why its needed tbh but fails without
+  preBuild = lib.optionalString (customKeyring != null) ''
+    chmod -R u+w vendor/github.com/zalando/go-keyring
+    substituteInPlace vendor/github.com/zalando/go-keyring/secret_service/secret_service.go \
+      --replace-fail '/org/freedesktop/secrets/aliases/default' '${customKeyring}'
+  '';
+
   ldflags = [
     "-s"
     "-w"
