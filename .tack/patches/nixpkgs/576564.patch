From c8f59668fb51be4b824bf2041db93fcdd52e4928 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Sandro=20J=C3=A4ckel?= <sandro.jaeckel@gmail.com>
Date: Tue, 20 Oct 2026 20:47:28 +0200
Subject: [PATCH] linuxPackages.r8125: install modules through modules_install

---
 pkgs/os-specific/linux/r8125/default.nix | 19 +++++++++++++------
 1 file changed, 13 insertions(+), 6 deletions(-)

diff --git a/pkgs/os-specific/linux/r8125/default.nix b/pkgs/os-specific/linux/r8125/default.nix
index 3dfdeb25c8144..d5b7ceabeb43a 100644
--- a/pkgs/os-specific/linux/r8125/default.nix
+++ b/pkgs/os-specific/linux/r8125/default.nix
@@ -22,21 +22,28 @@ stdenv.mkDerivation (finalAttrs: {
 
   nativeBuildInputs = kernel.moduleBuildDependencies;
 
-  preBuild = ''
+  # Allow changing BASEDIR with -C
+  postPatch = ''
     substituteInPlace src/Makefile --replace-fail "BASEDIR :=" "BASEDIR ?="
-    substituteInPlace src/Makefile --replace-fail "modules_install" "INSTALL_MOD_PATH=$out modules_install"
   '';
 
   makeFlags = kernelModuleMakeFlags ++ [
     "BASEDIR=${kernel.dev}/lib/modules/${kernel.modDirVersion}"
+    "INSTALL_MOD_PATH=${placeholder "out"}"
+    "INSTALL_MOD_DIR=kernel/drivers/net/ethernet/realtek"
+    "INSTALL_MOD_STRIP=1"
+    "DEPMOD=true"
   ];
 
   buildFlags = [ "modules" ];
 
-  installPhase = ''
-    mkdir -p $out/lib/modules/${kernel.modDirVersion}/kernel/drivers/net/ethernet/realtek
-    cp src/r8125.ko $out/lib/modules/${kernel.modDirVersion}/kernel/drivers/net/ethernet/realtek/
-  '';
+  installTargets = [ "modules_install" ];
+
+  installFlags = [
+    "-C"
+    "${kernel.dev}/lib/modules/${kernel.modDirVersion}/build"
+    "M=$(PWD)/src"
+  ];
 
   meta = {
     homepage = "https://salsa.debian.org/debian/r8125";
